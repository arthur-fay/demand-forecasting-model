# ATLAS environment variables. M0 needs no secrets and every variable is optional;
# command-line flags take precedence. Export them in your shell, or keep them in a
# git-ignored .env file and run `uv run --env-file .env atlas ...`.
# ATLAS does NOT load .env files automatically.

# Repository root containing `snapshots/`. Default: discovered by walking up from the
# current working directory.
# ATLAS_REPO_ROOT=/path/to/demand-forecasting-model

# Snapshot to verify, validate and reproduce. Default: legacy-v0
# ATLAS_SNAPSHOT_ID=legacy-v0

# --- M5 HTTP API (atlas api serve); see docs/API.md ---------------------------------------
# Browser origins allowed to call the API (comma-separated, no wildcard). Default: none.
# ATLAS_API_CORS_ORIGINS=http://localhost:5173
# Host names clients use (Host header; IPv6 without brackets). Default: localhost,127.0.0.1,::1
# ATLAS_API_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Secret protecting POST /api/v1/simulations (>= 24 characters). Required for a non-loopback
# bind. Keep it out of version control.
# ATLAS_API_KEY=
# Or (M6, preferred): a file holding the key, readable by its owner only (mode 0600/0400),
# e.g. a systemd credential. Exclusive with ATLAS_API_KEY.
# ATLAS_API_KEY_FILE=
# ATLAS_API_MAX_BODY_BYTES=16384
# ATLAS_API_MAX_CONCURRENT_SIMULATIONS=2
# ATLAS_API_SIMULATION_TIMEOUT_SECONDS=10
# ATLAS_API_DOCS=true
# ATLAS_API_LOG_LEVEL=INFO

# --- M6 deployment -------------------------------------------------------------------------
# A deployed server is configured by /etc/atlas/deploy.env, not by this file: see
# deploy/deploy.env.example and docs/DEPLOYMENT.md.
