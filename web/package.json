{
  "name": "atlas-dashboard",
  "version": "1.1.0",
  "private": true,
  "description": "ATLAS M7: the interactive web dashboard over the ATLAS HTTP API (same origin, /api/v1); M9: the same dashboard as a static, read-only build of the API's recorded answers (GitHub Pages).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:pages": "tsc --noEmit -p . && vite build --mode pages",
    "preview": "vite preview",
    "preview:pages": "node scripts/pages-server.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pages": "ATLAS_E2E_PAGES=1 playwright test",
    "gen:api": "openapi-typescript ../docs/api/openapi.json -o src/api/openapi.gen.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "size": "node scripts/size-report.mjs",
    "size:pages": "node scripts/size-report.mjs --pages"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
