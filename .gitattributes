# Snapshot integrity is verified byte-for-byte with SHA-256. Never let git rewrite line
# endings in any file registered in a snapshot manifest (e.g. core.autocrlf=true on
# Windows), or the legacy-v0 hashes would no longer match a fresh checkout.
# tests/test_snapshot.py checks that every registered path is covered by these rules.
*.csv -text
*.ipynb -text
*.sql -text
snapshots/** -text

# Legacy binary artifacts.
*.pbix binary
*.pdf binary
*.png binary

# The research results are verified byte for byte against the SHA-256 in their run
# manifests (verify, inspect, the API's readiness check, the M4 inputs); every release
# fingerprints them with the configurations; CI and build-release.sh compare the API
# contract byte for byte. tests/test_snapshot.py checks these rules as well.
docs/results/** -text
docs/api/openapi.json -text
configs/** -text

# The committed dashboard build and the API answers the frontend tests render are verified
# byte for byte (web/dist/atlas-dashboard.json, tests/test_m7_fixtures.py).
web/dist/** -text
# Copied byte for byte into the reproducible web/dist (favicon, font licence).
web/public/** -text
web/src/test/fixtures/** -text
# (M9) The static export: recorded API answers, verified byte for byte by `atlas static
# verify` and, in the browser, by their SHA-256 in the static build.
web/static-export/** -text
