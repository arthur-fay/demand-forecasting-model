# ATLAS deployment configuration: /etc/atlas/deploy.env (root:root 0644).
#
# One KEY=value per line: no quotes, no spaces, no shell syntax. Unknown or repeated keys
# are refused. NO SECRET BELONGS HERE: the simulation key is created by
# `atlas-deploy secrets init` and proxy passwords by `atlas-deploy secrets add-user`.
# After any change: atlas-deploy validate --installed, then atlas-deploy activate <current>.
# See docs/DEPLOYMENT.md.

# Access profile (private first):
#   tunnel       nothing exposed; reach the API through `ssh -L 8000:127.0.0.1:8000 server`
#   private      HTTPS for one domain, every route behind HTTP Basic authentication
#   public-demo  unauthenticated read-only routes; refused without SECURITY_REVIEW
ATLAS_DEPLOY_PROFILE=tunnel

# Resources: low (1 simulation worker; 1 GB server with swap) or standard (2 workers;
# 2 GB / 2 vCPU and above). Run the preflight to choose.
ATLAS_DEPLOY_RESOURCES=standard

# The DNS name of the private or public-demo deployment (an A/AAAA record to this server).
# ATLAS_DEPLOY_DOMAIN=atlas.example.org

# Certificate files (default: /etc/letsencrypt/live/<domain>/fullchain.pem and privkey.pem).
# ATLAS_DEPLOY_TLS_CERT=
# ATLAS_DEPLOY_TLS_KEY=

# Optional network allow-list for nginx, e.g. your office or VPN: 203.0.113.0/24,2001:db8::/48
# ATLAS_DEPLOY_ALLOW_CIDRS=

# Strict-Transport-Security max-age in seconds (300 to 63072000). Default: one year.
# ATLAS_DEPLOY_HSTS_MAX_AGE=31536000

# Whether nginx listens on IPv6 too (false on servers without IPv6).
# ATLAS_DEPLOY_IPV6=true

# Required by the public-demo profile: the reference of the completed security review.
# ATLAS_DEPLOY_SECURITY_REVIEW=

# The API (always bound to 127.0.0.1): port, simulation deadline, log level, docs.
# ATLAS_DEPLOY_API_PORT=8000
# ATLAS_DEPLOY_SIMULATION_TIMEOUT_SECONDS=10
# ATLAS_DEPLOY_LOG_LEVEL=INFO
# Interactive documentation (/docs) loads scripts from a CDN: tunnel profile only.
# ATLAS_DEPLOY_API_DOCS=false
