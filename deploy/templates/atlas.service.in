# ATLAS research API. Rendered by `atlas-deploy render` from /etc/atlas/deploy.env:
# do not edit this file; change deploy.env and render again.
#
# HYPOTHETICAL simulations over unvalidated forecasts (M3: FAILED_CALIBRATION). This
# service is not a validated NYC staffing or resource-allocation system.
[Unit]
Description=ATLAS research API (not a validated staffing or resource-allocation system)
Documentation=https://github.com/arthur-fay/demand-forecasting-model/blob/main/docs/DEPLOYMENT.md
After=network.target
# At most 6 starts in 15 minutes: then the unit stays failed until an operator acts
# (systemctl reset-failed atlas), so a broken release never restarts in a tight loop.
StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=main
User={{service_user}}
Group={{service_group}}
WorkingDirectory={{current}}
ExecStart={{executable}} api serve --host {{api_host}} --port {{api_port}}
EnvironmentFile={{runtime_env}}
Environment=ATLAS_REPO_ROOT={{current}}
Environment=ATLAS_API_KEY_FILE=%d/api-key
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1
# The simulation key is a credential: copied by systemd into a private, non-swappable
# directory readable by this service only; never in the environment or the unit.
LoadCredential=api-key:{{api_key}}
SyslogIdentifier=atlas-api
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000

# Lifecycle: ready only after the reference data is verified and the socket is bound
# (READY=1); a hung event loop misses the watchdog and the service is restarted.
TimeoutStartSec=120
TimeoutStopSec=30
TimeoutAbortSec=15
WatchdogSec=30
# SIGTERM to the server only: it finishes in-flight requests (up to 10 s) and stops its
# simulation workers itself; whatever remains afterwards is killed.
KillMode=mixed
KillSignal=SIGTERM
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
# Exit status 2 is an invalid configuration: restarting cannot fix it.
RestartPreventExitStatus=2
# A worker killed by the OOM killer is replaced by the pool; the service keeps running.
# (Workers raise their own OOM score, so the kernel picks one of them before the server.)
OOMPolicy=continue

# Resources ({{resources}} profile: {{workers}} simulation worker(s)).
MemoryHigh={{memory_high}}
MemoryMax={{memory_max}}
TasksMax={{tasks_max}}
CPUWeight=50
IOWeight=50
LimitNOFILE=4096
LimitCORE=0

# Sandbox: no privilege, a read-only system, loopback networking only.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-{{credentials}} -{{nginx_dir}} -{{state}}

[Install]
WantedBy=multi-user.target
