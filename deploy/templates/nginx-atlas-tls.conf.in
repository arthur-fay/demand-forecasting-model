
# HTTPS: the only way in.
server {
    listen 443 ssl;
{{listen_443_v6}}    server_name {{domain}};
    server_tokens off;
    access_log {{log_dir}}/atlas-access.log atlas_json;
    error_log {{log_dir}}/atlas-error.log warn;

    ssl_certificate {{tls_cert}};
    ssl_certificate_key {{tls_key}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:atlas_tls:5m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Requests are read completely, within short deadlines, before the API sees them.
    client_max_body_size 16k;
    client_body_buffer_size 16k;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 30s;
    keepalive_timeout 15s;
    keepalive_requests 100;
    reset_timedout_connection on;

    limit_conn atlas_conn {{connections_per_client}};
    limit_req zone=atlas_read burst={{read_burst}} nodelay;
    limit_req_status 429;
    limit_conn_status 429;
{{access_control}}
    # Response headers: set here, once (the API's own copies are hidden, never doubled).
    add_header Strict-Transport-Security "max-age={{hsts_max_age}}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Cache-Control;

    # Ambiguous request targets (encoded slashes, backslashes or dots, empty or dot
    # segments) are refused before any route is matched.
    if ($request_uri ~ "(%2[Ff]|%5[Cc]|%2[Ee]|//|/\.)") { return 400; }

    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    # The API answers within its simulation deadline ({{simulation_timeout}} s) plus margin.
    proxy_read_timeout {{proxy_read_timeout}}s;
    proxy_buffering on;
    proxy_buffer_size 16k;
    proxy_buffers 32 16k;
    proxy_busy_buffers_size 32k;
    proxy_max_temp_file_size 0;
    proxy_next_upstream off;

    # Errors made by nginx itself use the API's error body.
    error_page 400 = @atlas_400;
    error_page 401 = @atlas_401;
    error_page 403 = @atlas_403;
    error_page 404 = @atlas_404;
    error_page 405 = @atlas_405;
    error_page 413 = @atlas_413;
    error_page 429 = @atlas_429;
    error_page 500 502 503 504 = @atlas_upstream;
{{error_locations}}
    # The routes of the committed OpenAPI contract that this profile exposes; nothing else.
{{locations}}
    location / {
        return 404;
    }
}
