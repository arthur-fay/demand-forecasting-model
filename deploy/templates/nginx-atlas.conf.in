# ATLAS reverse proxy ({{profile}} profile, {{domain}}). Rendered by `atlas-deploy render`
# from /etc/atlas/deploy.env and the committed OpenAPI contract: do not edit this file;
# change deploy.env and render again.
#
# HYPOTHETICAL research outputs (M3: FAILED_CALIBRATION); not a validated staffing system.

# Per-client limits (the client address; ATLAS trusts no forwarding header).
limit_req_zone $binary_remote_addr zone=atlas_read:10m rate={{read_rate}};
limit_req_zone $binary_remote_addr zone=atlas_compute:2m rate={{compute_rate}};
limit_conn_zone $binary_remote_addr zone=atlas_conn:10m;

# One JSON object per request. No query string, no request header, no body: the path,
# the status, the timings, the client address and the authenticated user name only.
log_format atlas_json escape=json '{"ts":"$time_iso8601","request_id":"$request_id",'
    '"client":"$remote_addr","user":"$remote_user","method":"$request_method",'
    '"path":"$uri","status":$status,"bytes":$body_bytes_sent,'
    '"request_time":$request_time,"upstream_status":"$upstream_status",'
    '"upstream_time":"$upstream_response_time"}';

upstream atlas_api {
    # The API's Unix socket, in the service's own runtime directory: no other account can
    # create it, so none can stand in for the API while it restarts and receive the key.
    server unix:{{api_socket}};
}

# Any other host name: no answer on HTTP, no certificate on HTTPS.
server {
    listen 80 default_server;
{{listen_80_v6_default}}    server_name _;
    server_tokens off;
    access_log off;
    return 444;
}
{{default_tls_server}}
# HTTP: ACME challenges for certificate issuance and renewal; everything else moves to HTTPS.
server {
    listen 80;
{{listen_80_v6}}    server_name {{domain}};
    server_tokens off;
    access_log {{log_dir}}/atlas-access.log atlas_json;
    error_log {{log_dir}}/atlas-error.log warn;
    client_max_body_size 1k;
    limit_conn atlas_conn {{connections_per_client}};
    limit_req zone=atlas_read burst={{read_burst}} nodelay;

    location ^~ /.well-known/acme-challenge/ {
        root {{acme_root}};
        default_type text/plain;
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    }
    location / {
{{http_fallback}}
    }
}
{{tls_server}}